<section id="welcome-index-leader" class="jumbotron text-center">
  <div class="location-flag">
    <%= image_tag("flags/ch.png", alt: "Schweiz") %>
  </div>
  <div class="language-switcher">
     <%= link_to image_tag("flags/de.png", alt: "Deutsch"), switch_locale_path(locale: 'de') %>
     <%= link_to image_tag("flags/pt.png", alt: "Português"), switch_locale_path(locale: 'pt') %>
     <%= link_to image_tag("flags/en.png", alt: "English"), switch_locale_path(locale: 'en') %>
  </div>
  <div class="container">
    <h1 class="jumbotron-heading"><%= t :wedding_couple_names %></h1>
    <p class="leader-date">
      <%= t :wedding_date %>, <%= t :wedding_location %>
    </p>
    <p>
      <%= link_to (t :rsvp_today), new_guest_path, class: 'btn btn-primary wedding-cta-btn' %>
    </p>
  </div>
</section>
