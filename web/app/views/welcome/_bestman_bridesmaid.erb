<section id="welcome-index-bestman-leader" class="jumbotron text-center">
  <div class="container">
    <h1><%= t :bestman_bridesmaid %></h1>
  </div>
</section>
<section id="welcome-index-bestman">
  <div class="container">
      <!-- Games Suggestions -->
    <div class="row">
      <div class="col-md-12">
        <p><%= t :games_reachoutto_witnesses %></p>
      </div>
    </div>

    <div class="row">
      <!-- Best Man Section -->
      <div class="col-md-6 text-center">
          <div class="card">
            <img src="<%= asset_path('bestman.jpg') %>" alt="Best Man" class="card-img-top rounded-circle" style="width: 200px; height: 200px; object-fit: cover; margin: 20px auto;">
            <div class="card-body">
                <h4 class="card-title">Mauro Bamert</h4>
                <p class="card-text"><%= t :bestman %></p>
                <p><a href="mailto:padrinhos@gameoversinglelife.com">padrinhos@gameoversinglelife.com</a></p>
            </div>
          </div>
      </div>

      <!-- Bridesmaid Section -->
      <div class="col-md-6 text-center">
          <div class="card">
            <img src="<%= asset_path('bridesmaid.jpg') %>" alt="Bridesmaid" class="card-img-top rounded-circle" style="width: 200px; height: 200px; object-fit: cover; margin: 20px auto;">
            <div class="card-body">
                <h4 class="card-title">Lea Fluri</h4>
                <p class="card-text"><%= t :bridesmaid %></p>
                <p><a href="mailto:trauzeugen@gameoversinglelife.com">trauzeugen@gameoversinglelife.com</a></p>
            </div>
          </div>
      </div>
    </div>
  </div>
</div>
