<div class="container">
  <div class="row">
    <div class="offset-lg-2 col-lg-8">
      <%= render partial: 'leader' %>
      <p><%= t :form_email_description %></p>
      <%= form_with scope: :guest, url: guests_path, local: true do |form| %>
      <div class="row">
        <div class="col-md-12">
          <%= errors_for(@guest) %>
        </div>
      </div>

      <div class="form-group row">
        <div class="col-md-3">
          <%= form.label :guest_id, 'Guest ID', class: 'col-form-label' %>
          <span class="wedding-required">*</span>
        </div>
        <div class="col-md-9">
          <%= form.number_field :guest_id, id: "selected_guest_id", class: 'form-control', required: true, readonly: true %>
        </div>
      </div>

      <%= render partial: 'name', locals: { form: form, id_stem: 'guest' } %>

      <p>
        <h4><%= t :select_guest %></h4>
        <div id="suggestions"></div>
      </p>

      <div class="row guests-buttons">
        <div class="offset-md-3 col-md-6 text-center">
          <%- if ENV['RECAPTCHA_SECRET_KEY'].blank? -%>
          <%= form.submit (t :form_continue), class: 'btn btn-primary', data: { disable_with: 'Sending...' } %>
          <%- else -%>
          <%= invisible_recaptcha_tags text: (t :continue), class: 'btn btn-primary', data: { disable_with: 'Sending...' } %>
          <%- end -%>
        </div>
      </div>

      <% end %>

      <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
      <script>
        $(document).ready(function() {
            $("#guest_first_name").on("input", function() {
                let query = $(this).val().trim();
                if (query.length > 1) {
                    $.ajax({
                        url: "/guests/search",
                        type: "GET",
                        data: { name: query },
                        success: function(data) {
                            let suggestions = data.guests.map(guest =>
                                `<div class="suggestion" data-id="${guest.id}" data-firstname="${guest.first_name}" data-lastname="${guest.last_name}">- ${guest.first_name} ${guest.last_name}</div>`
                            ).join("");
                            $("#suggestions").html(suggestions);
                        }
                    });
                } 
                else {
                    $("#suggestions").html("");
                }
                $("#selected_guest_id").val("");
                $("#guest_last_name").val("");
            });

            $(document).on("click", ".suggestion", function() {
                let guestId = $(this).data("id");
                let guestFirstName = $(this).data("firstname");
                let guestLastName = $(this).data("lastname");

                $("#guest_first_name").val(guestFirstName);
                $("#guest_last_name").val(guestLastName);
                $("#selected_guest_id").val(guestId);
                $("#suggestions").html("");
            });
        });
      </script>
    </div>
  </div>
</div>
