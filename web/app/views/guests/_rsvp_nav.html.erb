<nav class="guests-rsvp-nav">
  <ul class="nav nav-pills nav-fill">
    <li class="nav-item">
      <%= link_to ('1. ' + (t :form_about_you)), guest_path(@guest), class: ['nav-link', active == 1 ? 'active' : ''] %>
    </li>
    <% if @guest.is_plus_ones_allowed %>
      <li class="nav-item">
        <% if active >= 2 %>
          <%= link_to ('2. ' + (t :form_plus_ones)), guest_plus_ones_path(@guest), class: ['nav-link', active == 2 ? 'active' : ''] %>
        <% else %>
          <a class="nav-link <%= active == 2 ? 'active' : '' %>">2. <%= t :form_plus_ones %></a>
        <% end %>
      </li>
     <% end %>
    <li class="nav-item">
      <% if active >= 3 %>
        <%= link_to ('3. ' + (t :form_confirm)), confirm_guest_path(@guest), class: ['nav-link', active == 3 ? 'active' : ''] %>
      <% else %>
        <a class="nav-link <%= active == 3 ? 'active' : '' %>">3. <%= t :form_confirm %></a>
      <% end %>
    </li>
  </ul>
</nav>
