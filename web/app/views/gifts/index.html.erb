<div class="gift-list">
  <h1>🎁 <%= t :gifts_title %> 🎁</h1>

  <div class="gift-item">
    <img src="assets/payment_options/cash.jpg" class="gift-image" />
    <div class="gift-details">
      <div class="gift-name">Geld / Dinheiro / Money</div>
      <p class="gift-description">
        Konntest du kein Geschenk finden?<br />
        Wir freuen uns auch auf Mithilfe für unsere Hochzeitsreise. :-)
        <br /><br />
        Não conseguiste achar nenhuma prenda?<br />
        Também ficamos contentes se contribuires para a nossa lua de mel. :-)
        <br /><br />
        You did not find any present?<br />
        We will also be happy if you contribute to our honeymoon. :-)
        <br /><br />
        <a href="/gifts/payment_options" target="_blank">Payment Options</a>
      </p>
    </div>
  </div>

  <% @gifts.each do |gift| %>
    <div class="gift-item <%= 'claimed' if gift.claimed %>">
      
      <!-- Gift Image -->
      <% if gift.image.attached? %>
        <img src="<%= url_for(gift.image) %>" alt="<%= gift.name %>" class="gift-image" />
      <% else %>
        <img src="assets/placeholder_gift.jpg" alt="<%= gift.name %>" class="gift-image" />
      <% end %>

      <!-- Gift Details -->
      <div class="gift-details">
        <div class="gift-name"><%= gift.name %></div>
        <p class="gift-description"><%= simple_format(gift.description) %></p>
        <p class="gift-description">Price Range:
          <% if gift.price_range == "$$$" %>
          💎💎💎
          <% elsif gift.price_range == "$$" %>
          💎💎
          <% else %>
          💎
          <% end %>
        </p>
        <% if gift.purchase_link.present? %>
          <p><a href="<%= gift.purchase_link %>" target="_blank">Shop Link</a></p>
        <% end %>

        <% if gift.claimed %>
          <p class="claimed-text">Claimed by <%= gift.claimer_name %></p>
        <% else %>
          <form action="<%= claim_gift_path(gift) %>" method="post" class="claim-form">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <input type="text" name="name" placeholder="Your Name" required>
            <input type="email" name="email" placeholder="Your Email" required>
            <button type="submit">Claim Gift 🎁</button>
          </form>
        <% end %>
      </div>

    </div>
  <% end %>
</div>

