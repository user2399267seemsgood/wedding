<div class="container mt-5">
  <h1 class="text-center mb-4"><%= t :payment_options_title %></h1>
  <div class="gift-list">
    <% @payment_methods.each do |method| %>
      <div class="col-md-4 mb-4">
        <div class="gift-item">
          <img src="<%= asset_path(method[:image]) %>" class="gift-image">
          <div class="gift-details">
            <div class="gift-name"><%= method[:title] %></div>
            <p class="gift-description"><%= simple_format(method[:description]) %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
