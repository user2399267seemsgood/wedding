<p><%= @guest.email_safe_salutation %></p>

<% if @guest.attending %>
<p><%= t :mail_rsvp_lookingforward %>!</p>
<p><%= t :mail_rsvp_weddingaddress %>:</p>
<address><%= render partial: 'application/wedding_address' %></address>

<h3><%= t :rsvp_title %></h3>
<p><%= t :mail_rsvp_getback %>:</p>
<p><%= link_to guest_url(@guest), guest_url(@guest) %></p>

<h3><%= t :mail_rsvp_qa %></h3>
<p><%= t :mail_rsvp_pleasecheck %> <%= link_to (t :mail_rsvp_ourweddingsite), root_url %> <%= t :mail_rsvp_formoreinfo %></p>
<% else %>
<p><%= t :mail_rsvp_cantmakeit %></p>
<p><%= link_to guest_url(@guest), guest_url(@guest) %></p>
<p><%= t :mail_rsvp_seeyou %></p>
<% end %>

<p>&nbsp;</p>
<p><%= t :wedding_couple_names %></p>
